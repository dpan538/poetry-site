{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "sh scripts/build-vercel",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.daipan.ink"
        }
      ],
      "destination": "https://daipan.ink/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/editions/Three-Worlds-2026-Digital-Edition.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Three-Worlds-2026-Digital-Edition.pdf\""
        }
      ]
    },
    {
      "source": "/assets/immutable/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
