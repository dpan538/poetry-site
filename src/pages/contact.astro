---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publication } from '../lib/publication';

const contactDescription =
  'Contact and permissions reference for daipan.ink, the poetry site of Dai Pan / 潘岱 and Three Worlds.';

const breadcrumbs = [
  { name: 'Three Worlds', url: 'https://daipan.ink/' },
  { name: 'Contact', url: 'https://daipan.ink/contact' },
];
---

<BaseLayout title="Contact" description={contactDescription} breadcrumbs={breadcrumbs}>
  <main class="reading-page">
    <header class="reading-header">
      <h1>Contact</h1>
      <p class="reading-meta">Dai Pan / Pan Dai 潘岱</p>
    </header>

    <section class="reading-prose">
      <p>
        daipan.ink is the poetry site of Dai Pan / 潘岱. It contains <em>Three Worlds</em>, a
        collection of 79 poems written from the threshold.
      </p>
      <p lang="zh-Hans">
        daipan.ink 是潘岱的诗集站点，收录《三个世界》。
      </p>
      <p>
        For permissions and public contact links, visit
        <a href={publication.visualArtUrl} target="_blank" rel="noopener noreferrer">daipan.art</a>.
      </p>
      <p>
        A personal archive of moving images and field material is at
        <a href={publication.archiveUrl} target="_blank" rel="noopener noreferrer">inpraiseoftime.site</a>.
        This site is for the poems.
      </p>
    </section>
  </main>
</BaseLayout>
